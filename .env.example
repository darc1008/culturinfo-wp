# ===========================================
# Culturinfo - WordPress config
# ===========================================
# Generated by Hermes Agent for culturinfo.statusloop.app
# Copy to .env and fill values before first deploy

MARIADB_DATABASE=culturinfo
MARIADB_USER=culturinfo
MARIADB_PASSWORD=CHANGE_ME_STRONG_RANDOM

# Public URL (no trailing slash)
WP_SITEURL=https://culturinfo.statusloop.app
TRUST_PROXY_HEADERS=true
WP_LOCALE=es_ES

# Security. Create the free widget in Cloudflare Turnstile before enabling it.
CULTURINFO_TURNSTILE_ENABLED=false
CULTURINFO_TURNSTILE_SITE_KEY=
CULTURINFO_TURNSTILE_SECRET_KEY=
# Keep false unless a documented mobile/Jetpack integration needs XML-RPC.
CULTURINFO_XMLRPC_ENABLED=false

# Automatic local backups. Create a persistent volume mounted at /backups
# before enabling. Hour is interpreted using TZ.
CULTURINFO_BACKUPS_ENABLED=false
CULTURINFO_BACKUP_HOUR=3
CULTURINFO_BACKUP_RETENTION_DAYS=30
TZ=America/Santo_Domingo

# Admin (created on first seed)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=CHANGE_ME_STRONG_RANDOM
WP_ADMIN_EMAIL=admin@culturinfo.statusloop.app
WP_TITLE=Culturinfo
WP_TAGLINE=Periódico digital de Horizonte Cultural
